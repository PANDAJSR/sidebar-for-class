{
  "name": "sidebar-for-class",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "vite",
    "electron": "wait-on http://localhost:3000 && tsx scripts/run-electron.ts",
    "dev": "concurrently \"npm run start\" \"npm run electron\"",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "echo \"Error: no test specified\" && exit 1",
    "compile": "tsc"
  },
  "build": {
    "appId": "com.sidebar.class",
    "productName": "SidebarForClass",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main/**/*",
      "main.ts",
      "main.js",
      "preload.ts",
      "preload.js",
      "package.json",
      "main-utils.ts",
      "main-utils.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PANDAJSR/sidebar-for-class.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PANDAJSR/sidebar-for-class/issues"
  },
  "homepage": "https://github.com/PANDAJSR/sidebar-for-class#readme",
  "devDependencies": {
    "@fluentui/react-components": "^9.72.9",
    "@fluentui/react-icons": "^2.0.316",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^5.1.2",
    "concurrently": "^9.2.1",
    "electron": "^39.8.5",
    "electron-builder": "^26.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/joy": "^5.0.0-beta.52",
    "canvas": "^3.2.1",
    "loudness": "^0.4.2",
    "mdui": "^2.1.4",
    "screenshot-desktop": "^1.15.3",
    "sharp": "^0.34.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "canvas",
      "sharp",
      "esbuild"
    ]
  }
}
